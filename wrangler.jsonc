// Cloudflare Workers deploy: serves the Vite build as static assets (no Worker
// code). Response headers, including the COOP/COEP the engine needs, come from
// public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texture-janitor",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist"
  }
}
